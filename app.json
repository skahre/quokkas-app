{
  "expo": {
    "name": "Qoll: Allergi Scanner",
    "slug": "food-scanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "foodscanner",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/ios-logo.png",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-foreground.png",
        "backgroundColor": "#176B68"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.sandra.kahre.qoll",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/ios-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#176B68",
          "image": "./assets/android-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Appen använder kameran för att skanna streckkoder.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a10e349b-4e9f-485b-bc79-4049d8b4d1db"
      }
    }
  }
}
